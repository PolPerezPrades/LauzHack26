  "phrases": [
    {
      "id": "ph-name",
      "signs": [
        "w-you",
        "w-name",
        "w-what"
      ],
      "en": "What is your name?",
      "es": "¿Cómo te llamas?",
      "nonManual": "wh",
      "note": {
        "es": "Las preguntas con QUÉ/DÓNDE/POR QUÉ suelen ir al final, con las cejas fruncidas.",
        "en": "WH-question signs (WHAT, WHERE, WHY) usually go at the end, with furrowed eyebrows."
      }
    },
    {
      "id": "ph-deaf",
      "signs": [
        "w-you",
        "w-deaf"
      ],
      "en": "Are you deaf?",
      "es": "¿Eres sordo/a?",
      "nonManual": "yn",
      "note": {
        "es": "Pregunta de sí/no: cejas levantadas y cabeza ligeramente hacia delante. ASL no usa verbo «ser».",
        "en": "Yes/no question: raised eyebrows and the head tilted slightly forward. ASL doesn’t use the verb “to be”."
      }
    },
    {
      "id": "ph-pizza",
      "signs": [
        "w-me",
        "w-like",
        "w-pizza"
      ],
      "en": "I like pizza.",
      "es": "Me gusta la pizza.",
      "nonManual": "neutral",
      "note": {
        "es": "Orden básico sujeto-verbo-objeto.",
        "en": "Basic subject–verb–object order."
      }
    },
    {
      "id": "ph-hungry",
      "signs": [
        "w-me",
        "w-hungry"
      ],
      "en": "I am hungry.",
      "es": "Tengo hambre.",
      "nonManual": "neutral",
      "note": {
        "es": "Sin verbo «estar/tener»: el adjetivo va directamente tras el sujeto.",
        "en": "No verb “to be”: the adjective goes right after the subject."
      }
    },
    {
      "id": "ph-school",
      "signs": [
        "w-today",
        "w-me",
        "w-go",
        "w-school"
      ],
      "en": "Today I go to school.",
      "es": "Hoy voy a la escuela.",
      "nonManual": "neutral",
      "note": {
        "es": "Las marcas de tiempo (HOY, MAÑANA) van al principio de la frase.",
        "en": "Time signs (TODAY, TOMORROW) go at the start of the sentence."
      }
    },
    {
      "id": "ph-work",
      "signs": [
        "w-tomorrow",
        "w-me",
        "w-work"
      ],
      "en": "Tomorrow I work.",
      "es": "Mañana trabajo.",
      "nonManual": "neutral",
      "note": {
        "es": "El tiempo se marca al inicio; el verbo no cambia.",
        "en": "Time is marked at the start; the verb doesn’t change."
      }
    },
    {
      "id": "ph-water",
      "signs": [
        "w-you",
        "w-want",
        "w-water"
      ],
      "en": "Do you want water?",
      "es": "¿Quieres agua?",
      "nonManual": "yn",
      "note": {
        "es": "Pregunta de sí/no: cejas levantadas durante toda la frase.",
        "en": "Yes/no question: eyebrows raised throughout the whole sentence."
      }
    },
    {
      "id": "ph-sister",
      "signs": [
        "w-my",
        "w-sister",
        "w-deaf"
      ],
      "en": "My sister is deaf.",
      "es": "Mi hermana es sorda.",
      "nonManual": "topic",
      "note": {
        "es": "Tópico-comentario: MI HERMANA (cejas arriba) se presenta primero, luego el comentario.",
        "en": "Topic–comment: MY SISTER (eyebrows raised) comes first, then the comment."
      }
    },
    {
      "id": "ph-why",
      "signs": [
        "w-you",
        "w-learn",
        "w-sign",
        "w-why"
      ],
      "en": "Why are you learning sign language?",
      "es": "¿Por qué aprendes lengua de signos?",
      "nonManual": "wh",
      "note": {
        "es": "POR QUÉ al final con cejas fruncidas.",
        "en": "WHY at the end, with furrowed eyebrows."
      }
    },
    {
      "id": "ph-understand",
      "signs": [
        "w-me",
        "w-not",
        "w-understand"
      ],
      "en": "I don't understand.",
      "es": "No entiendo.",
      "nonManual": "neg",
      "note": {
        "es": "La negación se acompaña de un movimiento de cabeza de lado a lado.",
        "en": "The negation comes with a head shake from side to side."
      }
    },
    {
      "id": "ph-coffee",
      "signs": [
        "w-coffee",
        "w-you",
        "w-like"
      ],
      "en": "Do you like coffee?",
      "es": "¿Te gusta el café?",
      "nonManual": "yn",
      "note": {
        "es": "El objeto se topicaliza al principio (cejas arriba) y la pregunta mantiene las cejas levantadas.",
        "en": "The object is topicalized at the start (eyebrows raised), and the question keeps the eyebrows raised."
      }
    },
    {
      "id": "ph-ate",
      "signs": [
        "w-me",
        "w-finish",
        "w-eat"
      ],
      "en": "I already ate.",
      "es": "Ya he comido.",
      "nonManual": "neutral",
      "note": {
        "es": "FINISH antes del verbo indica una acción ya completada.",
        "en": "FINISH before the verb marks an action that is already completed."
      }
    },
    {
      "id": "ph-where-work",
      "signs": [
        "w-you",
        "w-work",
        "w-where"
      ],
      "en": "Where do you work?",
      "es": "¿Dónde trabajas?",
      "nonManual": "wh",
      "note": {
        "es": "DÓNDE al final con cejas fruncidas.",
        "en": "WHERE at the end, with furrowed eyebrows."
      }
    },
    {
      "id": "ph-family",
      "signs": [
        "w-my",
        "w-family",
        "w-me",
        "w-love"
      ],
      "en": "I love my family.",
      "es": "Quiero a mi familia.",
      "nonManual": "topic",
      "note": {
        "es": "Tópico-comentario: MI FAMILIA primero (cejas arriba), luego YO AMAR.",
        "en": "Topic–comment: MY FAMILY first (eyebrows raised), then ME LOVE."
      }
    }
  ]
}
